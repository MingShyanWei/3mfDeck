{
  "name": "mf-cabinet",
  "productName": "3mfDeck",
  "version": "0.1.0",
  "description": "Offline 3MF library and filament colour advisor",
  "author": {
    "name": "Caspar Wei",
    "url": "https://github.com/MingShyanWei"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite build && electron .",
    "build": "vite build",
    "start": "electron .",
    "fixtures": "node scripts/make-fixtures.mjs",
    "test": "vitest run",
    "smoke": "vite build && node tests/smoke/smoke.mjs",
    "dist": "vite build && electron-builder --mac dmg",
    "dist:mac": "vite build && electron-builder --mac dmg --arm64",
    "dist:win": "vite build && electron-builder --win nsis portable --x64",
    "dist:linux": "vite build && electron-builder --linux AppImage deb --x64",
    "realfiles": "vite build && node tests/smoke/realfiles.mjs",
    "orcacompare": "vite build && node tests/smoke/orcacompare.mjs"
  },
  "build": {
    "appId": "app.foobox.3mfdeck",
    "productName": "3mfDeck",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**",
      "src/core/**",
      "dist/**",
      "package.json",
      "!node_modules/better-sqlite3/{deps,src,docs}/**"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": false,
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "identity": "-",
      "hardenedRuntime": false,
      "files": [
        "electron/**",
        "src/core/**",
        "dist/**",
        "package.json",
        "!node_modules/better-sqlite3/{deps,src,docs}/**",
        "!node_modules/better-sqlite3/prebuilds/{win32,linux,linuxmusl}*"
      ]
    },
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "electron/**",
        "src/core/**",
        "dist/**",
        "package.json",
        "!node_modules/better-sqlite3/{deps,src,docs}/**",
        "!node_modules/better-sqlite3/prebuilds/{darwin,linux,linuxmusl}*"
      ]
    },
    "deb": {
      "packageName": "3mfdeck",
      "artifactName": "3mfdeck_${version}_${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "icon": "build/icon.png",
      "maintainer": "Caspar Wei <6902864+MingShyanWei@users.noreply.github.com>",
      "category": "Utility",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "files": [
        "electron/**",
        "src/core/**",
        "dist/**",
        "package.json",
        "!node_modules/better-sqlite3/{deps,src,docs}/**",
        "!node_modules/better-sqlite3/prebuilds/{darwin,win32}*"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "jszip": "^3.10.2"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "electron-winstaller": false
  }
}
